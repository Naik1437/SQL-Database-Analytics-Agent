# Gemini Developer API for SQL generation. Select a model marked free in your AI Studio project.
GOOGLE_API_KEY=your_gemini_api_key
GOOGLE_MODEL=your_selected_free_tier_model

DATABASE_URL=sqlite:///database/analytics.db
NEMO_GUARDRAILS_CONFIG=config/guardrails

# Keep false to use NeMo configuration plus the deterministic safety filter only.
# Setting true opts into a separate live NeMo inference integration using OpenAI.
NEMO_LIVE_INFERENCE=false
# OPENAI_API_KEY=optional_key_only_if_live_nemo_inference_is_explicitly_enabled
# OPENAI_MODEL=gpt-4o-mini
